{
  "$schema": "https://github.com/afkzonagroup/offramp/raw/main/schema/provider-profile.schema.json",
  "format": "offramp/provider-profile",
  "version": 1,
  "provider": {
    "name": "Example Cloud",
    "legalName": "Example Cloud UAB",
    "website": "https://cloud.example.com",
    "contactEmail": "switching@cloud.example.com",
    "switchingContact": "switching@cloud.example.com, or the \"Switch provider\" page in the console"
  },
  "timeZone": "Europe/Vilnius",
  "workingDays": {
    "calendarName": "Lithuania, 2026-2027 (example list, check against the official calendar)",
    "publicHolidays": [
      "2026-11-02",
      "2026-12-24",
      "2026-12-25",
      "2026-12-26",
      "2027-01-01",
      "2027-02-16",
      "2027-03-11",
      "2027-03-29"
    ]
  },
  "services": [
    {
      "id": "vm",
      "name": "Example Virtual Machines",
      "deliveryModel": "iaas",
      "serviceType": "Virtual machines: on-demand compute instances with block storage and virtual networks.",
      "regime": "standard",
      "exportableData": [
        {
          "id": "vm-disks",
          "name": "Disk images",
          "origin": "input",
          "formats": [
            {
              "name": "QCOW2",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true,
              "openSpecification": true
            },
            {
              "name": "Raw disk image",
              "mediaType": "application/octet-stream",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true
            }
          ]
        },
        {
          "id": "vm-metadata",
          "name": "Instance and network configuration",
          "origin": "metadata",
          "formats": [
            {
              "name": "JSON",
              "mediaType": "application/json",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true,
              "openSpecification": true
            }
          ]
        }
      ],
      "digitalAssets": [
        {
          "id": "vm-images",
          "name": "Custom machine images",
          "kind": "virtual-machine",
          "formats": [
            {
              "name": "OVF",
              "specificationUrl": "https://www.dmtf.org/standards/ovf",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true,
              "openSpecification": true
            }
          ]
        }
      ],
      "exemptedData": [
        {
          "id": "vm-scheduler",
          "name": "Internal placement and scheduling data",
          "reason": "Describes the internal capacity planning of the platform; exporting it would reveal trade secrets. It is not needed to run the workloads elsewhere.",
          "tradeSecretRisk": true
        }
      ],
      "switchingMethods": [
        "Disk image export to object storage, then download",
        "Image export through the API"
      ],
      "knownRestrictions": [
        "Instances must be stopped during the final disk export."
      ],
      "standards": [
        "OVF (DMTF DSP0243)"
      ],
      "functionalEquivalence": {
        "capabilities": true,
        "information": true,
        "documentation": true,
        "technicalSupport": true,
        "tools": [
          "Export CLI"
        ]
      },
      "unbundling": "feasible",
      "estimatedSwitchingTime": "One to five days, depending on data volume"
    },
    {
      "id": "crm",
      "name": "Example CRM",
      "deliveryModel": "saas",
      "serviceType": "Customer relationship management software for small businesses.",
      "regime": "standard",
      "exportableData": [
        {
          "id": "crm-records",
          "name": "Contacts, companies, deals and activities",
          "origin": "input",
          "formats": [
            {
              "name": "CSV (RFC 4180)",
              "mediaType": "text/csv",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true,
              "openSpecification": true
            },
            {
              "name": "JSON",
              "mediaType": "application/json",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true,
              "openSpecification": true
            }
          ]
        },
        {
          "id": "crm-files",
          "name": "Uploaded files",
          "origin": "input",
          "formats": [
            {
              "name": "Original files in a ZIP archive",
              "mediaType": "application/zip",
              "structured": false,
              "commonlyUsed": true,
              "machineReadable": true
            }
          ]
        },
        {
          "id": "crm-reports",
          "name": "Saved reports and their results",
          "origin": "output",
          "formats": [
            {
              "name": "CSV (RFC 4180)",
              "mediaType": "text/csv",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true
            }
          ]
        },
        {
          "id": "crm-audit",
          "name": "Audit log of user actions",
          "origin": "metadata",
          "formats": [
            {
              "name": "JSON Lines",
              "mediaType": "application/jsonl",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true
            }
          ]
        }
      ],
      "digitalAssets": [
        {
          "id": "crm-workflows",
          "name": "Automation workflows",
          "kind": "configuration",
          "formats": [
            {
              "name": "JSON",
              "mediaType": "application/json",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true
            }
          ]
        },
        {
          "id": "crm-roles",
          "name": "Users, roles and permissions",
          "kind": "access-rights",
          "formats": [
            {
              "name": "JSON",
              "mediaType": "application/json",
              "structured": true,
              "commonlyUsed": true,
              "machineReadable": true
            }
          ]
        }
      ],
      "exemptedData": [],
      "interfaces": [
        {
          "name": "Export API",
          "kind": "api",
          "documentationUrl": "https://docs.cloud.example.com/crm/export-api",
          "freeOfCharge": true,
          "availableToAllCustomers": true,
          "availableToDestinationProviders": true
        },
        {
          "name": "Full account export",
          "kind": "bulk-export",
          "documentationUrl": "https://docs.cloud.example.com/crm/full-export",
          "freeOfCharge": true,
          "availableToAllCustomers": true,
          "availableToDestinationProviders": true
        }
      ],
      "switchingMethods": [
        "Full account export (ZIP with CSV, JSON and files)",
        "Export API for incremental transfer"
      ],
      "knownRestrictions": [],
      "standards": [
        "RFC 4180 (CSV)",
        "RFC 8259 (JSON)"
      ],
      "freeTier": true,
      "estimatedSwitchingTime": "Same day for most accounts"
    }
  ],
  "contract": {
    "writtenContract": true,
    "availableBeforeSigning": true,
    "storableAndReproducible": true,
    "switchingClause": true,
    "transitionDays": 30,
    "reasonableAssistance": true,
    "businessContinuity": true,
    "knownRisksInformation": true,
    "highLevelOfSecurity": true,
    "exitStrategySupport": true,
    "terminationOnSuccessfulSwitch": true,
    "terminationOnEraseAtNoticeEnd": true,
    "terminationNotified": true,
    "noticePeriod": {
      "unit": "months",
      "value": 2
    },
    "retrievalDays": 30,
    "erasureGuaranteed": true,
    "chargesClause": true,
    "optionSwitchToProvider": true,
    "optionSwitchToOnPremises": true,
    "optionErase": true,
    "unfeasibilityClause": true,
    "unfeasibilityNoticeWorkingDays": 14,
    "maxAlternativeTransitionMonths": 7,
    "customerExtensionRight": true,
    "internationalAccessWebsitesListed": true,
    "clauseRefs": {
      "noticePeriod": "14.2",
      "transitionDays": "14.3",
      "retrievalDays": "14.6",
      "erasureGuaranteed": "14.7",
      "customerExtensionRight": "14.4"
    }
  },
  "information": {
    "switchingProcedures": "Send a switching request from the console (Settings > Switch provider) or by e-mail. Choose the services, the data and the destination. We confirm receipt and send a switching plan with all dates.",
    "onlineRegisterUrl": "https://docs.cloud.example.com/data-register",
    "registerCoversDataStructures": true,
    "registerCoversDataFormats": true,
    "registerCoversStandards": true,
    "registerCoversOpenInteroperabilitySpecifications": true,
    "preContractStandardServiceFees": true,
    "preContractEarlyTerminationPenalties": true,
    "preContractReducedSwitchingCharges": true,
    "chargesInformationUrl": "https://cloud.example.com/switching-charges"
  },
  "internationalAccess": {
    "jurisdictions": [
      "Lithuania (European Union)"
    ],
    "jurisdictionInformationUrl": "https://cloud.example.com/legal/jurisdiction",
    "measuresInformationUrl": "https://cloud.example.com/legal/government-access"
  },
  "charges": {
    "currency": "EUR",
    "items": [
      {
        "id": "egress",
        "name": "Data egress for switching",
        "kind": "data-egress",
        "amountMinor": 2,
        "unit": "per GB",
        "directlyLinkedCostMinor": 2,
        "costBasis": "Transit cost per GB paid to upstream networks, 2026 average.",
        "appliesUntil": "2027-01-11"
      },
      {
        "id": "monthly",
        "name": "Monthly subscription",
        "kind": "standard-service-fee",
        "amountMinor": 4900,
        "unit": "per month"
      },
      {
        "id": "migration-support",
        "name": "Hands-on migration engineering",
        "kind": "additional-service",
        "amountMinor": 9000,
        "unit": "per hour",
        "onlyOnCustomerRequest": true,
        "priceAgreedInAdvance": true
      }
    ]
  }
}
