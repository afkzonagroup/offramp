{
  "name": "@afkzona/offramp",
  "version": "0.1.0",
  "description": "Switching between data processing services under Chapter VI of the Data Act (Regulation (EU) 2023/2854): provider profile checks, switching request timelines, switching charge checks and customer documents. Offline, zero runtime dependencies.",
  "license": "AGPL-3.0-only",
  "author": "MB AFKzona Group <info@afkzonagroup.lt>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afkzonagroup/offramp.git"
  },
  "homepage": "https://github.com/afkzonagroup/offramp#readme",
  "bugs": {
    "url": "https://github.com/afkzonagroup/offramp/issues"
  },
  "keywords": [
    "data-act",
    "regulation-2023-2854",
    "cloud-switching",
    "data-portability",
    "egress-charges",
    "saas",
    "iaas",
    "compliance"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "offramp": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/provider-profile.schema.json": "./schema/provider-profile.schema.json",
    "./schema/switching-request.schema.json": "./schema/switching-request.schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "schema/",
    "examples/",
    "LICENSE",
    "LICENSE-ADDITIONAL-TERMS.md",
    "COMMERCIAL.md",
    "TRADEMARKS.md",
    "LEGAL.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test",
    "schema:write": "node scripts/write-schemas.ts",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
